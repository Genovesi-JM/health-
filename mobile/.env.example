# Kaya mobile public build configuration
# Expo embeds EXPO_PUBLIC_* values in the app bundle. Do not put secrets here.
# Set an actual reviewed HTTPS API URL in the distribution build environment.
# The current informational entry does not activate API calls.
EXPO_PUBLIC_API_URL=

# Local development examples (choose an address reachable by the test device):
# iOS Simulator: EXPO_PUBLIC_API_URL=http://localhost:8000
# Android emulator: EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
# Physical device: use your development server's reachable address.

# Legacy alias, used only when EXPO_PUBLIC_API_URL is empty:
# EXPO_PUBLIC_API_BASE_URL=
