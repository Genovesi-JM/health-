# ═══════════════════════════════════════════════════════════════
# Health Platform — Backend Environment Variables
#
# Local dev:  copy to backend/.env  →  docker compose up
# Production: set as App/Droplet env vars (DO App Platform or .env on Droplet)
#
# NEVER commit a file containing real values.
# Generate secrets with:  openssl rand -base64 48
# ═══════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────
# dev | staging | production
ENV=dev

# ── Security ─────────────────────────────────────────────────
# REQUIRED in production — generate: openssl rand -base64 48
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ──────────────────────────────────────────────────
# Local SQLite (dev only):
DATABASE_URL=sqlite:///./health_platform.db
#
# Docker Compose local PostgreSQL:
# DATABASE_URL=postgresql://health_user:changeme@db:5432/health_platform
#
# DigitalOcean Managed PostgreSQL (production — recommended):
# DATABASE_URL=postgresql://doadmin:<password>@<host>.db.ondigitalocean.com:25060/defaultdb?sslmode=require
# Note: DO provides this exact string in the "Connection Details" panel.
# The fix_postgres_url validator in config.py also handles postgres:// → postgresql://

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated. Must include your frontend origin(s).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── URLs ──────────────────────────────────────────────────────
# Used to build OAuth callbacks and password-reset links (no trailing slash).
FRONTEND_BASE=http://localhost:5173
BACKEND_BASE=http://localhost:8000

# ── Admin Seed Account ────────────────────────────────────────
# Password for the seeded admin account.  Change immediately after first login.
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ── SMTP (optional — for password reset & notification emails) ─
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com
SMTP_USE_TLS=true

# ── Google OAuth (optional) ───────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── DigitalOcean Spaces (optional — file storage) ─────────────
# Create a Space in your DO account, then generate an access key.
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=health-platform-files
DO_SPACES_REGION=fra1
DO_SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com

# ── Redis (optional — rate-limiting / caching) ────────────────
# Leave empty to disable.  Set to redis://redis:6379/0 for Docker Compose.
REDIS_URL=

# ── OpenAI (optional — AI chatbot) ───────────────────────────
OPENAI_API_KEY=

# ── Stripe (optional — payments) ─────────────────────────────
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_STRIPE_TEST_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_STRIPE_TEST_SECRET
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_STRIPE_TEST_KEY

# ── Regional payment adapters (sandbox placeholders only) ────
# Never use these literal placeholders in a deployed environment.
MULTICAIXA_API_URL=https://sandbox.example.emis.ao/v1
MULTICAIXA_MERCHANT_ID=demo_kaya_merchant
MULTICAIXA_API_KEY=test_REPLACE_WITH_EMIS_KEY
MULTICAIXA_WEBHOOK_SECRET=test_REPLACE_WITH_EMIS_WEBHOOK_SECRET
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_PAYSTACK_KEY
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-REPLACE_WITH_FLUTTERWAVE_KEY
DPO_COMPANY_TOKEN=test_REPLACE_WITH_DPO_TOKEN
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=test_REPLACE_WITH_PAYPAL_CLIENT_ID
PAYPAL_SECRET=test_REPLACE_WITH_PAYPAL_SECRET

# ── Encryption (optional — field-level sensitive data) ────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Docker Compose only (not used by app directly) ────────────
# Password for the local docker-compose PostgreSQL container.
DB_PASSWORD=changeme
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── Microsoft OAuth (optional) ──
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback
MICROSOFT_TENANT=common

# ── Email / SMTP (password resets) ──
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=no-reply@healthplatform.com
# SMTP_PASSWORD=your_password
# SMTP_FROM=no-reply@healthplatform.com
# SMTP_USE_TLS=true

# ═══════════════════════════════════════════════════════════════
# Verification providers (Phase 2–4). All optional: when unset,
# each adapter transparently falls back to the in-process SANDBOX
# provider so development works with zero external contracts.
# The SANDBOX providers are clearly marked mode=mock and can NEVER
# activate a real production professional (compliance must approve).
# ═══════════════════════════════════════════════════════════════

# Global mode switch: live | sandbox
#   live    = use configured vendor APIs where present, sandbox per-vendor otherwise
#   sandbox = force in-process deterministic providers everywhere (staging demos)
KAYA_VERIFICATION_MODE=live

# Which vendor to route to (swap without code changes):
IDENTITY_PROVIDER=sumsub          # sumsub | sandbox
QUALIFICATION_PROVIDER=veremark   # veremark | certn | sandbox

# ── Sumsub — identity + liveness (Step 3) ──
# Dashboard: https://cockpit.sumsub.com → Dev space → App Tokens
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_LEVEL_NAME=basic-kyc-level
# Webhook callback to register in Sumsub: POST {BACKEND}/api/v1/webhooks/sumsub

# ── Azure AI Document Intelligence — field extraction (Step 6) ──
# Azure portal → Document Intelligence resource → Keys and Endpoint
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_MODEL_ID=kaya-credential-v1
AZURE_DOCUMENT_API_VERSION=2024-11-30

# ── Veremark — education / employment / licence checks (Step 7) ──
# https://app.veremark.com → Settings → API
VEREMARK_API_KEY=
VEREMARK_WEBHOOK_SECRET=
# Webhook callback: POST {BACKEND}/api/v1/webhooks/veremark

# ── Certn — Veremark alternative (Step 7 fallback) ──
# https://app.certn.co → Settings → API keys
CERTN_API_KEY=
CERTN_WEBHOOK_SECRET=
# Webhook callback: POST {BACKEND}/api/v1/webhooks/certn

# ── Microsoft Entra Verified ID — optional digital credential (Step 8) ──
# Entra admin center → Verified ID + an app registration with
# VerifiableCredential.Create.All. Most institutions do not issue these,
# so this step is always optional.
AZURE_ENTRA_TENANT_ID=
AZURE_ENTRA_CLIENT_ID=
AZURE_ENTRA_CLIENT_SECRET=

# ── MFA (TOTP) ──
# No external service required — TOTP is computed in-process with the
# standard library and works with Google Authenticator / Authy / etc.
# MFA is mandatory for doctor, nurse, pharmacist, corporate_admin,
# compliance_reviewer, and admin roles.

# ── Document-expiry scheduler (optional in-process) ──
# When enabled, the backend runs the credential-expiry scan every N hours
# in-process. Leave disabled to drive scans via external cron hitting
# POST /api/v1/compliance/expiry/scan instead.
EXPIRY_SCAN_ENABLED=false
EXPIRY_SCAN_INTERVAL_HOURS=24
