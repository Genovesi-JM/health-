# Public builds stay informational. An empty API URL alone is NOT a hold:
# the operational client falls back to relative requests on the website origin.
# A clinical release needs a separately reviewed policy/deployment decision.
VITE_OPERATIONAL_HOLD=true

# Azure base path: pass VITE_BASE_PATH=/ at build time (vite.config reads it from
# the process env, not this file). The GitHub Pages build uses /health-/ instead.
# IMPORTANT: Never use plain HTTP for health data. Always use HTTPS.
VITE_API_URL=
